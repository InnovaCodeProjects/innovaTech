# Innova Tech — Apache config for Hostinger shared hosting
#
# Lives in public/ so `vite build` copies it into dist/ on every build.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: innovatech.dev.br and www.innovatech.dev.br both resolve,
  # which splits ranking signals. Everything folds into www, matching the
  # canonical/og:url tags and the sitemap.
  RewriteCond %{HTTP_HOST} ^innovatech\.dev\.br$ [NC]
  RewriteRule ^(.*)$ https://www.innovatech.dev.br/$1 [R=301,L]

  # SPA fallback: let React Router handle any route that isn't a real file
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Gzip/deflate compression for text-based assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain application/xml application/javascript application/json image/svg+xml
</IfModule>

# Long-lived cache for hashed, immutable build assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|webp|jpe?g|svg|woff2?|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html now carries the inlined stylesheet, so it must never be cached
  # stale against freshly hashed JS.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Discovery documents change independently of the build hash.
  <FilesMatch "^(llms\.txt|robots\.txt|sitemap\.xml|ard\.json|ai-catalog\.json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Agent/crawler discovery documents must be served with the right type.
<IfModule mod_mime.c>
  AddType application/json .json
  AddType text/plain .txt
</IfModule>
